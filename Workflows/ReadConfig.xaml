  <Sequence DisplayName="Read Config" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="configFullPath" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Settings" />
    </Sequence.Variables>
    <Assign DisplayName="Resolve config path" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="configFullPath" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="Path.GetFullPath(in_ConfigPath)" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="If config file is missing" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="Not File.Exists(configFullPath)" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Throw DisplayName="Throw config not found" sap2010:WorkflowViewState.IdRef="Throw_1">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">
                <VisualBasicValue x:TypeArguments="s:Exception" ExpressionText="New BusinessRuleException(&quot;Config file not found: &quot; &amp; configFullPath)" />
              </InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <ui:ReadRange AddHeaders="True" DataTable="[dt_Settings]" DisplayName="Read Settings sheet" Range="{x:Null}" SheetName="Settings" WorkbookPath="[configFullPath]" sap2010:WorkflowViewState.IdRef="ReadRange_1" />
    <Assign DisplayName="Build config dictionary" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">
          <VisualBasicReference x:TypeArguments="scg:Dictionary(x:String, x:Object)" ExpressionText="out_Config" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">
          <VisualBasicValue x:TypeArguments="scg:Dictionary(x:String, x:Object)" ExpressionText="dt_Settings.AsEnumerable().Where(Function(r) Not String.IsNullOrWhiteSpace(r(&quot;Name&quot;).ToString)).ToDictionary(Function(r) r(&quot;Name&quot;).ToString.Trim, Function(r) r(&quot;Value&quot;))" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" DisplayName="Log config loaded" sap2010:WorkflowViewState.IdRef="LogMessage_1">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Config loaded: &quot; &amp; out_Config.Count.ToString &amp; &quot; settings from &quot; &amp; configFullPath" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
