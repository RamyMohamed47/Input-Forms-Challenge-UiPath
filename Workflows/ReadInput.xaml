  <Sequence DisplayName="Read Input" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputFullPath" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Raw" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="requiredColumns" Default="[New List(Of String) From {&quot;First Name&quot;, &quot;Last Name&quot;, &quot;Company Name&quot;, &quot;Role in Company&quot;, &quot;Address&quot;, &quot;Email&quot;, &quot;Phone Number&quot;}]" />
      <Variable x:TypeArguments="x:String" Name="missingColumns" />
      <Variable x:TypeArguments="scg:List(sd:DataRow)" Name="dataRows" />
    </Sequence.Variables>
    <Assign DisplayName="Resolve input path" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="inputFullPath" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="Path.GetFullPath(in_FilePath)" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="If input file is missing" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="Not File.Exists(inputFullPath)" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Throw DisplayName="Throw input not found" sap2010:WorkflowViewState.IdRef="Throw_1">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">
                <VisualBasicValue x:TypeArguments="s:Exception" ExpressionText="New BusinessRuleException(&quot;Input file not found: &quot; &amp; inputFullPath)" />
              </InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <ui:ReadRange AddHeaders="True" DataTable="[dt_Raw]" DisplayName="Read input sheet" Range="{x:Null}" SheetName="[in_SheetName]" WorkbookPath="[inputFullPath]" sap2010:WorkflowViewState.IdRef="ReadRange_1" />
    <ui:ForEach x:TypeArguments="sd:DataColumn" DisplayName="For each column - trim header" sap2010:WorkflowViewState.IdRef="ForEach`1_1">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="sc:IEnumerable">
          <VisualBasicValue x:TypeArguments="sc:IEnumerable" ExpressionText="dt_Raw.Columns" />
        </InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="sd:DataColumn">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataColumn" Name="column" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_3">
            <Assign DisplayName="Trim column name" sap2010:WorkflowViewState.IdRef="Assign_2">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <VisualBasicReference x:TypeArguments="x:String" ExpressionText="column.ColumnName" />
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <VisualBasicValue x:TypeArguments="x:String" ExpressionText="column.ColumnName.Trim" />
                </InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <Assign DisplayName="Find missing columns" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="missingColumns" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="String.Join(&quot;, &quot;, requiredColumns.Where(Function(c) Not dt_Raw.Columns.Contains(c)))" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="If required columns are missing" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="Not String.IsNullOrEmpty(missingColumns)" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
          <Throw DisplayName="Throw missing columns" sap2010:WorkflowViewState.IdRef="Throw_2">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">
                <VisualBasicValue x:TypeArguments="s:Exception" ExpressionText="New BusinessRuleException(&quot;Input file is missing required column(s): &quot; &amp; missingColumns)" />
              </InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Keep non-blank rows" sap2010:WorkflowViewState.IdRef="Assign_4">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(sd:DataRow)">
          <VisualBasicReference x:TypeArguments="scg:List(sd:DataRow)" ExpressionText="dataRows" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(sd:DataRow)">
          <VisualBasicValue x:TypeArguments="scg:List(sd:DataRow)" ExpressionText="dt_Raw.AsEnumerable().Where(Function(r) requiredColumns.Any(Function(c) Not String.IsNullOrWhiteSpace(r(c).ToString))).ToList()" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="If there are no data rows" sap2010:WorkflowViewState.IdRef="If_3">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="dataRows.Count = 0" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_5">
          <Throw DisplayName="Throw no data rows" sap2010:WorkflowViewState.IdRef="Throw_3">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">
                <VisualBasicValue x:TypeArguments="s:Exception" ExpressionText="New BusinessRuleException(&quot;Input file has no data rows: &quot; &amp; inputFullPath)" />
              </InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Build output table with required columns" sap2010:WorkflowViewState.IdRef="Assign_5">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">
          <VisualBasicReference x:TypeArguments="sd:DataTable" ExpressionText="out_Data" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">
          <VisualBasicValue x:TypeArguments="sd:DataTable" ExpressionText="dataRows.CopyToDataTable().DefaultView.ToTable(False, requiredColumns.ToArray())" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage Level="Info" DisplayName="Log rows read" sap2010:WorkflowViewState.IdRef="LogMessage_1">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Input loaded: &quot; &amp; out_Data.Rows.Count.ToString &amp; &quot; rows from &quot; &amp; inputFullPath" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
